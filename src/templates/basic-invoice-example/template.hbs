<div class="invoice-modern-shell">
  <div class="no-dibella invoice-letterhead{{#unless invoice.letterHead}} is-empty{{/unless}}">
    {{#if invoice.letterHead}}
      <img src="{{invoice.letterHead}}" alt="Letterhead" data-ceres-height="letterhead" />
    {{else}}
      <img alt="Letterhead" data-ceres-height="letterhead" />
    {{/if}}
  </div>

  <div class="invoice-modern-container">
  <div class="invoice-header-modern">
    <div class="logo-section">
      <h1>{{ invoice.invoiceTitle }}</h1>
      <p>For Professional Services</p>
      <div style="margin-top:8px">{{> DemoBadge }}</div>
    </div>
  </div>

  <div class="info-block-modern">
    <div class="info-section invoice-details">
      <h3>Invoice Details</h3>
      <p>
        <span class="meta-label">{{invoice.customLabels.invoiceNumber}}</span>
        <strong>{{invoice.invoiceNumber}}</strong>
      </p>
      <p>
        <span class="meta-label">{{invoice.customLabels.invoiceDate}}:</span>
        {{formateShortDateWithOffset invoice.invoiceDate invoice.ownerOffset}}
      </p>
      <p>
        <span class="meta-label">{{invoice.customLabels.dueDate}}:</span>
        <strong>{{formateShortDateWithOffset invoice.dueDate invoice.ownerOffset}}</strong>
      </p>
      {{#if invoice.irn}}
      {{#if invoice.irn.Irn}}
      <p>
        <span class="meta-label">IRN:</span>
        <span data-ceres-field="irn" class="irn-value">{{invoice.irn.Irn}}</span>
      </p>
      {{/if}}
      {{#if invoice.irn.AckDt}}
      <p>
        <span class="meta-label">IRN Ack Date:</span>
        {{formatDateInTimeZone invoice.irn.AckDt "UTC" "SECONDARY_SHORT_DATE_FORMAT"}}
      </p>
      {{/if}}
      {{#if invoice.irn.CancelDate}}
      <p>
        <span class="meta-label">IRN Cancelled On:</span>
        {{formateShortDateWithOffset invoice.irn.CancelDate invoice.ownerOffset}}
      </p>
      {{/if}}
      {{#if invoice.irn.EwbDt}}
      <p>
        <span class="meta-label">E-Way Bill Date:</span>
        {{formatDateInTimeZone invoice.irn.EwbDt "UTC" "SECONDARY_SHORT_DATE_FORMAT"}}
      </p>
      {{/if}}
      {{#if invoice.irn.EwbValidTill}}
      <p>
        <span class="meta-label">E-Way Valid Till:</span>
        {{formatDateInTimeZone invoice.irn.EwbValidTill "UTC" "SECONDARY_SHORT_DATE_FORMAT"}}
      </p>
      {{/if}}
      {{#if invoice.irn.ewayCancelDate}}
      <p>
        <span class="meta-label">E-Way Cancelled On:</span>
        {{formatDateInTimeZone invoice.irn.ewayCancelDate "UTC" "SECONDARY_SHORT_DATE_FORMAT"}}
      </p>
      {{/if}}
      {{/if}}
      {{!-- QR code: always present in DOM; src populated via postMessage after e-invoice generation --}}
      <div data-ceres-field-container="qrCode" class="irn-qr-container is-empty">
        <img data-ceres-field="qrCode" src="" alt="E-Invoice QR Code" class="irn-qr-image" />
      </div>
      {{!-- Status tag using the minimal InvoiceStatus widget --}}
      <p>
        <span class="meta-label">Status:</span>
        {{> InvoiceStatus invoice }}
      </p>
      {{#if invoice.purchaseOrderNumber}}
      <p>
        <span class="meta-label">{{invoice.customLabels.purchaseOrderNumber}}:</span>
        {{invoice.purchaseOrderNumber}}
      </p>
      {{/if}}
    </div>

    <div class="info-section billed-by">
      <h3>{{invoice.customLabels.billedBy}}</h3>
      <p><strong>{{invoice.billedBy.name}}</strong></p>
      <p>
        {{invoice.billedBy.street}}<br />{{invoice.billedBy.city}}, {{invoice.billedBy.state}}
        {{invoice.billedBy.pincode}}<br />{{invoice.billedBy.country}}
      </p>
      {{#if invoice.billedBy.vatNumber}}
      <p>
        <span class="vat-number-label">{{invoice.billedBy.vatLabel}}:</span>
        {{invoice.billedBy.vatNumber}}
      </p>
      {{/if}}
      {{#if invoice.billedBy.phone}}
        <p>Phone: {{formatPhoneNumber invoice.billedBy.phone}}</p>
      {{/if}}
    </div>

    <div class="info-section billed-to">
      <h3>{{invoice.customLabels.billedTo}}</h3>
      <p><strong>{{invoice.billedTo.name}}</strong></p>
      <p>
        {{invoice.billedTo.street}}<br />{{invoice.billedTo.city}}, {{invoice.billedTo.state}}
        {{invoice.billedTo.pincode}}<br />{{invoice.billedTo.country}}
      </p>
      {{#if invoice.billedTo.gstin}}
      <p>GSTIN: {{invoice.billedTo.gstin}}</p>
      {{/if}}
      {{#if invoice.billedTo.phone}}
        <p>Phone: {{formatPhoneNumber invoice.billedTo.phone}}</p>
      {{/if}}
    </div>

    {{#if invoice.transportDetails}}
    <div class="info-section transport-details">
      <h3>Transport</h3>
      {{#if invoice.transportDetails.transport}}
      <p>
        <span class="meta-label">Mode:</span>
        {{invoice.transportDetails.transport}}
      </p>
      {{/if}}
      {{#if invoice.transportDetails.transportMode}}
      <p>
        <span class="meta-label">Transport Mode:</span>
        {{invoice.transportDetails.transportMode}}
      </p>
      {{/if}}
      {{#if invoice.transportDetails.challanNumber}}
      <p>
        <span class="meta-label">Challan No.:</span>
        {{invoice.transportDetails.challanNumber}}
      </p>
      {{/if}}
      {{#if invoice.transportDetails.challanDate}}
      <p>
        <span class="meta-label">Challan Date:</span>
        {{formateDateWithOffset invoice.transportDetails.challanDate invoice.ownerOffset}}
      </p>
      {{/if}}
      {{#if invoice.transportDetails.extraInformation}}
      <p>
        <span class="meta-label">Notes:</span>
        {{invoice.transportDetails.extraInformation}}
      </p>
      {{/if}}
    </div>
    {{/if}}
  </div>

  {{> LineItemsTable mapped}}

  <div class="totals-full-width-section">
    <div class="total-line">
      <span class="label">{{invoice.customLabels.subTotal}}:</span>
      <span class="value">{{formatCurrency invoice.totals.subTotal}}</span>
    </div>
    {{#if invoice.totals.discount}}
    <div class="total-line">
      <span class="label">Discount:</span>
      <span class="value">- {{formatCurrency invoice.totals.discount}}</span>
    </div>
    {{/if}}
    {{#if invoice.totals.igst}}
    <div class="total-line">
      <span class="label">IGST:</span>
      <span class="value">{{formatCurrency invoice.totals.igst}}</span>
    </div>
    {{/if}}
    {{#if invoice.totals.cgst}}
    <div class="total-line">
      <span class="label">CGST:</span>
      <span class="value">{{formatCurrency invoice.totals.cgst}}</span>
    </div>
    {{/if}}
    {{#if invoice.totals.sgst}}
    <div class="total-line">
      <span class="label">SGST:</span>
      <span class="value">{{formatCurrency invoice.totals.sgst}}</span>
    </div>
    {{/if}}
    {{#if invoice.totals.amountRoundOff}}
    <div class="total-line">
      <span class="label">Amount Round Off:</span>
      <span class="value">{{formatCurrency invoice.totals.amountRoundOff}}</span>
    </div>
    {{/if}}
    {{#if invoice.totals.totalRoundOff}}
    <div class="total-line">
      <span class="label">Total Round Off:</span>
      <span class="value">{{formatCurrency invoice.totals.totalRoundOff}}</span>
    </div>
    {{/if}}
    <div class="total-line grand">
      <span class="label">{{invoice.customLabels.total}}:</span>
      <span class="value">{{formatCurrency invoice.totals.total}}</span>
    </div>
    {{#if invoice.latePaymentFee}}
    {{#if invoice.dueDate}}
    {{#if invoice.latePaymentFee.showInInvoice}}
    {{#if invoice.latePaymentFee.enabled}}
    {{#unless invoice.latePaymentFee.isApplied}}
    <div class="total-line late-fee">
      <span class="label">Late Payment Fee:</span>
      <span class="value">
        {{#if invoice.latePaymentFee.finalAmount}}Additional {{invoice.latePaymentFee.finalAmount}} {{/if}}
        {{#if invoice.latePaymentFee.when}}
          after {{formatDateAddDays invoice.dueDate invoice.latePaymentFee.when invoice.ownerOffset}}
        {{/if}}
      </span>
    </div>
    {{/unless}}
    {{/if}}
    {{/if}}
    {{/if}}
    {{/if}}
    <div class="total-in-words">
      <span>{{invoice.customLabels.totalInWords}}:</span>
      <span>{{invoice.customLabels.totalInWordsValue}}</span>
    </div>
  </div>

  <div data-ceres-tax-summary{{#unless (taxTableVisible advanceOptions.taxSummaryView)}} style="display:none"{{/unless}}>
  {{> TaxSummaryTable (computeTaxSummary invoice.items isIgst=invoice.isIgst isUtgst=invoice.isUtgst) }}
  </div>

  <div data-ceres-hsn-summary{{#unless advanceOptions.showHSNSummaryInInvoice}} style="display:none"{{/unless}}>
  {{> HsnSummaryTable (computeHsnSummary invoice.items isIgst=invoice.isIgst isUtgst=invoice.isUtgst) }}
  </div>

  <div data-ceres-payment-table{{#if (eq advanceOptions.showPaymentsTable false)}} style="display:none"{{/if}}>
  {{> PaymentTable (computePaymentColumns invoice.allPayments businessCurrency=invoice.businessCurrency currency=invoice.currency)
      ownerOffset=invoice.ownerOffset
      heading="Payments"
  }}
  </div>

  <div class="notes-terms-modern-section">
    {{#if invoice.notes}}
    <div class="notes-modern-block">
      <h3>{{invoice.customLabels.notes}}</h3>
      {{> MarkdownViewer (prepareMarkdownViewerData invoice.notes) }}
    </div>
    {{/if}}
    {{#if invoice.terms.0.terms.length}}
    <div class="terms-modern-block">
      <h3>{{invoice.customLabels.terms}}</h3>
      <ul>
        {{#each invoice.terms.0.terms}}
        <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>
    {{/if}}
  </div>

  {{!-- Regional QR codes: always in DOM; src populated via postMessage from Lydia --}}
  <div class="regional-qr-section">
    <div data-ceres-field-container="zatcaQrCode" class="regional-qr-container is-empty">
      <img data-ceres-field="zatcaQrCode" src="" alt="ZATCA QR Code" class="regional-qr-image" />
    </div>
    <div data-ceres-field-container="lhdnQrCode" class="regional-qr-container is-empty">
      <img data-ceres-field="lhdnQrCode" src="" alt="LHDN QR Code" class="regional-qr-image" />
    </div>
    <div data-ceres-field-container="documentQr" class="regional-qr-container is-empty">
      <img data-ceres-field="documentQr" src="" alt="Document QR Code" class="regional-qr-image" />
    </div>
  </div>

  <div class="invoice-footer-modern">
    <p>&copy; 2025 {{invoice.billedBy.name}}. All rights reserved.</p>
  </div>

    {{> RefrensBranding invoice}}

  </div>

  <div class="no-dibella invoice-letterhead-footer{{#unless invoice.letterHeadFooter}} is-empty{{/unless}}">
    {{#if invoice.letterHeadFooter}}
      <img src="{{invoice.letterHeadFooter}}" alt="Letterhead footer" data-ceres-height="letterhead-footer" />
    {{else}}
      <img alt="Letterhead footer" data-ceres-height="letterhead-footer" />
    {{/if}}
  </div>
</div>
