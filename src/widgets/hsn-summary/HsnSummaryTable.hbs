{{#if hasRows}}
<div class="ceres-table-section">
  <table class="ceres-table">
    <thead>
      <tr>
        <th>HSN</th>
        <th>Taxable Value</th>
        {{#if isIgst}}
        <th colspan="2">IGST</th>
        {{else}}
        <th colspan="2">CGST</th>
        <th colspan="2">{{#if isUtgst}}UTGST{{else}}SGST{{/if}}</th>
        {{/if}}
        {{#if hasCess}}<th colspan="2">Cess</th>{{/if}}
        <th>Total</th>
      </tr>
      <tr>
        <th></th>
        <th></th>
        {{#if isIgst}}
        <th>Rate</th>
        <th>Amount</th>
        {{else}}
        <th>Rate</th>
        <th>Amount</th>
        <th>Rate</th>
        <th>Amount</th>
        {{/if}}
        {{#if hasCess}}<th>Rate</th><th>Amount</th>{{/if}}
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{#each hsnList}}
      <tr>
        <td>{{hsn}}</td>
        <td>{{taxableValue}}</td>
        {{#if ../isIgst}}
        <td>{{igstRate}}%</td>
        <td>{{igstAmount}}</td>
        {{else}}
        <td>{{cgstRate}}%</td>
        <td>{{cgstAmount}}</td>
        <td>{{sgstRate}}%</td>
        <td>{{sgstAmount}}</td>
        {{/if}}
        {{#if ../hasCess}}<td>{{cessRate}}%</td><td>{{cessAmount}}</td>{{/if}}
        <td>{{taxAmount}}</td>
      </tr>
      {{/each}}
    </tbody>
    <tfoot>
      <tr>
        <td><strong>Total</strong></td>
        <td><strong>{{totalTaxableValue}}</strong></td>
        {{#if isIgst}}
        <td></td>
        <td><strong>{{totalIgstAmount}}</strong></td>
        {{else}}
        <td></td>
        <td><strong>{{totalCgstAmount}}</strong></td>
        <td></td>
        <td><strong>{{totalSgstAmount}}</strong></td>
        {{/if}}
        {{#if hasCess}}<td></td><td><strong>{{totalCessAmount}}</strong></td>{{/if}}
        <td><strong>{{totalTaxAmount}}</strong></td>
      </tr>
      <tr>
        <td colspan="99" class="ceres-table-words">Total Tax In Words: {{amountInWords totalTaxAmount}}</td>
      </tr>
    </tfoot>
  </table>
</div>
{{/if}}
