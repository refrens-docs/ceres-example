{
  "name": "ceres",
  "version": "1.0.0",
  "private": true,
  "description": "Ceres - Static ES5 renderer with templates and widgets",
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "build": "webpack --config webpack.config.js",
    "build:clean": "npm run clean && webpack --config webpack.config.js",
    "build:system": "cross-env BUILD_SYSTEM_ONLY=1 webpack --config webpack.config.js",
    "build:templates": "cross-env BUILD_TEMPLATES_ONLY=1 webpack --config webpack.config.js",
    "build:template": "cross-env BUILD_TEMPLATES_ONLY=1 TEMPLATE=$npm_config_template webpack --config webpack.config.js",
    "test": "jest"
  },
  "browserslist": [
    "ie 11",
    "last 2 versions"
  ],
  "sideEffects": [
    "*.css"
  ],
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-typescript": "^7.25.0",
    "@babel/plugin-transform-runtime": "^7.25.0",
    "@types/jest": "^29.5.12",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "core-js": "^3.38.1",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "cross-env": "^7.0.3",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "handlebars": "^4.7.8",
    "handlebars-loader": "^1.7.3",
    "jest": "^29.7.0",
    "mini-css-extract-plugin": "^2.9.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.2",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0"
  }
}
